rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() 
        && (request.auth.token.admin == true || request.auth.token.role == "admin");
    }

    function isOficinas() {
      return isSignedIn() 
        && request.auth.token.role == "oficinas";
    }

    function cineDoc(cineId) {
      return get(/databases/$(database)/documents/cines/$(cineId));
    }

    function isCineUser(cineId) {
      return isSignedIn()
        && request.auth.token.cineId != null
        && request.auth.token.cineId == cineId;
    }

    function canAccessCine(cineId) {
      return isAdmin() || isCineUser(cineId);
    }

    // Documento raíz del cine: admin y oficinas pueden leer (oficinas necesita listar cines)
    // Los usuarios de cine NO deben leer este documento directamente
    match /cines/{cineId} {
      allow read: if isAdmin() || isOficinas();
      allow write: if false; // Solo Cloud Functions pueden escribir
    }

    // IPs autorizadas: solo admin puede leer/escribir
    // Cloud Functions gestionan esto para usuarios normales
    match /cines/{cineId}/authorizedIps/{ipDocId} {
      allow read: if isAdmin();
      allow write: if false; // Solo Cloud Functions
    }

    // Intentos de PIN por IP: solo Cloud Functions
    match /cines/{cineId}/ipAttempts/{attemptId} {
      allow read, write: if false; // Solo Cloud Functions
    }

    // Subcolección info/config: usuarios del cine pueden leer/escribir su config
    match /cines/{cineId}/info/config {
      allow read, write: if canAccessCine(cineId);
    }

    // Eventos: admin, oficinas y usuario del cine pueden acceder
    match /cines/{cineId}/eventos/{eventoId} {
      allow read, write: if isAdmin() || isOficinas() || isCineUser(cineId);
    }

    // Calendario: admin, oficinas y usuario del cine pueden acceder
    match /cines/{cineId}/calendario/{calendarId} {
      allow read, write: if isAdmin() || isOficinas() || isCineUser(cineId);
    }

    // RMAs: solo admin y usuario del cine
    match /cines/{cineId}/rmas/{rmaId} {
      allow read, write: if canAccessCine(cineId);
    }

    // Créditos: solo admin y usuario del cine
    match /cines/{cineId}/creditos/{creditoId} {
      allow read, write: if canAccessCine(cineId);
    }

    // Marketing/Programaciones: solo admin y usuario del cine
    match /cines/{cineId}/marketing/{docId} {
      allow read, write: if canAccessCine(cineId);
    }

    match /cines/{cineId}/programaciones/{progId} {
      allow read, write: if canAccessCine(cineId);
    }

    // Resto de subcolecciones del cine: acceso solo para admin y usuario del cine
    match /cines/{cineId}/{document=**} {
      allow read, write: if canAccessCine(cineId);
    }

    // Estadísticas de uso: todos los usuarios autenticados pueden escribir
    match /stats/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}

