{
    "buildCommand": "npm run build:web && node vercel-postbuild.js",
    "outputDirectory": "dist",
    "devCommand": "expo",
    "framework": null,
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/((?!_expo/|assets/|.*\\.[a-zA-Z0-9]+$).*)",
        "destination": "/index.html"
      }
    ]
  }